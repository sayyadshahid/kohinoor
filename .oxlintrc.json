{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "public/maplibre/**"
  ],
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/layout.tsx",
        "src/components/ui/map.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
